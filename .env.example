# ===== Required =====
# LLM provider key (OpenAI by default; see MEM0_DEFAULT_LLM_MODEL below).
# The server refuses to start without one. Alternatively export it in your
# shell: OPENAI_API_KEY=sk-... docker compose up -d
OPENAI_API_KEY=

# ===== Optional: other bundled LLM/embedder providers =====
# Set the key for the provider you want to use
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ===== Postgres (defaults are fine for local deployment) =====
# POSTGRES_PASSWORD=mem0-postgres   # default; change for anything beyond local use
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_COLLECTION_NAME=memories
# APP_DB_NAME=mem0_app

# ===== Auth =====
# JWT signing secret. If unset, one is generated on first start and persisted
# in the mem0_history volume. Generate your own: openssl rand -base64 48
# JWT_SECRET=
# Pre-seed an admin API key (optional; otherwise use the setup wizard)
# ADMIN_API_KEY=
# Local development only. Leave false in production.
# AUTH_DISABLED=false
# DASHBOARD_URL=http://localhost:3000

# ===== Default models =====
# Provider must be one of the bundled providers (see server/main.py)
# MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
# MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# ===== Telemetry =====
# Anonymous telemetry, one onboarding event per install. Set false to opt out.
# MEM0_TELEMETRY=true
